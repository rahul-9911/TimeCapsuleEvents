# SnapEvent ComfyUI Worker — Environment Variables
# Copy this to .env and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────────

# Base URL of your SnapEvent API (no trailing slash)
SNAPEVENT_API_URL=https://your-api-gateway-url.execute-api.ap-south-1.amazonaws.com

# Static API key — must match WORKER_API_KEY env var on the Lambda function
WORKER_API_KEY=REPLACE_WITH_YOUR_GENERATED_KEY

# S3 bucket where photos are stored
S3_BUCKET=snapevent-dev-photos

# AWS region
AWS_REGION=ap-south-1

# ── ComfyUI ───────────────────────────────────────────────────────────────────

# ComfyUI base URL
COMFYUI_URL=http://localhost:8188

# Path to ComfyUI's input folder (worker copies images here before submitting)
COMFYUI_INPUT_DIR=/home/rahul/comfy/ComfyUI/input

# Path to ComfyUI's output folder (worker reads generated images from here)
COMFYUI_OUTPUT_DIR=/home/rahul/comfy/ComfyUI/output

# ── Tuning ────────────────────────────────────────────────────────────────────

# How often the worker polls SnapEvent API for new jobs (seconds)
POLL_INTERVAL_SECONDS=30

# How often to poll ComfyUI /history for completion of each image (seconds)
COMFY_POLL_INTERVAL=3.0

# Max seconds to wait for a single image to complete in ComfyUI before giving up
COMFY_TIMEOUT=600.0

# ── Logging ───────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
